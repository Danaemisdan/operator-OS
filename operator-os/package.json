{
  "name": "operator-os",
  "version": "0.1.0",
  "description": "Operator OS — Autonomous AI Browser",
  "main": "out/main/index.js",
  "author": "Operator OS",
  "private": true,
  "scripts": {
    "dev": "ELECTRON_EXTRA_LAUNCH_ARGS='--disable-gpu-compositing --disable-software-rasterizer' electron-vite dev",
    "build": "electron-vite build",
    "start": "ELECTRON_EXTRA_LAUNCH_ARGS='--disable-gpu-compositing --disable-software-rasterizer' electron-vite dev",
    "preview": "electron-vite preview",
    "pack": "electron-vite build && electron-builder",
    "dist": "electron-vite build && electron-builder --publish=never"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@xstate/react": "^4.1.3",
    "@xyflow/react": "^12.10.2",
    "ollama": "^0.5.11",
    "sql.js": "^1.12.0",
    "xstate": "^5.18.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "playwright": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "build": {
    "appId": "com.operatoros.app",
    "productName": "Operator OS",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "arch": [
        "arm64",
        "x64"
      ],
      "icon": "resources/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/icon.ico"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ]
  }
}
